<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted preferences from cloud backup -->
        <exclude domain="sharedpref" path="scroll_control_encrypted_prefs" />
        <exclude domain="sharedpref" path="androidx.security.crypto.MasterKey" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude encrypted preferences from device transfer -->
        <exclude domain="sharedpref" path="scroll_control_encrypted_prefs" />
        <exclude domain="sharedpref" path="androidx.security.crypto.MasterKey" />
    </device-transfer>
</data-extraction-rules>